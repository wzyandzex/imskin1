{
  "name": "imskin",
  "private": true,
  "version": "0.0.0",
  "description": "输入法皮肤智能体系统 — 生成搜狗/百度 PC 与移动端皮肤，实时预览与多轮反馈迭代",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:node": "node --test packages/{pinyin-engine,skin-gen,project-model,feedback-core,qa-core,zip,sogou-adapter,sogou-mobile-adapter,baidu-pc-adapter,baidu-mobile-adapter,orchestrator,llm-core,api}/test/*.test.ts",
    "test:web": "vitest run --root packages/web-app",
    "bench:pinyin": "node packages/pinyin-engine/bench/run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @imskin/web-app",
    "verify": "npm run typecheck && npm test && npm run build",
    "ci": "npm run verify",
    "test:e2e": "npm run test:e2e -w @imskin/web-app --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
